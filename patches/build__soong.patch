+// usesLibraryLocations records canonical runtime paths instead of assuming /system.
+func (u *usesLibrary) usesLibraryLocations(ctx android.ModuleContext) map[string]string {
+	locations := make(map[string]string)
+	if !ctx.Config().UnbundledBuild() {
+		ctx.VisitDirectDepsWithTag(usesLibTag, func(m android.Module) {
+			if lib, ok := m.(interface{ DexInstallPath() android.InstallPath }); ok {
+				location := android.InstallPathToOnDevicePath(ctx, lib.DexInstallPath())
+				if strings.HasPrefix(location, "/system/product/") || strings.HasPrefix(location, "/system/system_ext/") {
+					location = strings.TrimPrefix(location, "/system")
+				}
+				locations[ctx.OtherModuleName(m)] = location
+			}
+		})
+	}
+	return locations
+}
+
 // enforceUsesLibraries returns true of <uses-library> tags should be checked against uses_libs and optional_uses_libs
