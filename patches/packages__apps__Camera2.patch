diff --git a/src/com/android/camera/one/v2/OneCameraCharacteristicsImpl.java b/src/com/android/camera/one/v2/OneCameraCharacteristicsImpl.java
index 77e9a81..17395c7 100644
--- a/src/com/android/camera/one/v2/OneCameraCharacteristicsImpl.java
+++ b/src/com/android/camera/one/v2/OneCameraCharacteristicsImpl.java
@@ -72,6 +72,17 @@ public class OneCameraCharacteristicsImpl implements OneCameraCharacteristics {
         for (android.util.Size androidSize : configMap.getOutputSizes(imageFormat)) {
             supportedPictureSizes.add(new Size(androidSize));
         }
+        // Still capture may use slower high-resolution outputs too. The
+        // normal list omits frost's 13 MP modes because they run below 20 fps.
+        android.util.Size[] highResolutionSizes = configMap.getHighResolutionOutputSizes(imageFormat);
+        if (highResolutionSizes != null) {
+            for (android.util.Size androidSize : highResolutionSizes) {
+                Size size = new Size(androidSize);
+                if (!supportedPictureSizes.contains(size)) {
+                    supportedPictureSizes.add(size);
+                }
+            }
+        }
         return supportedPictureSizes;
     }
 
