+package com.caf.fmradio;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Environment;
+import android.os.ParcelFileDescriptor;
+import android.provider.MediaStore;
+import android.util.Log;
+import java.io.Closeable;
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+import java.util.UUID;
+
+/** Own pending MediaStore recording; no access to other applications' audio. */
+final class FmRecordingStore implements Closeable {
+    private static final String TAG="FMRecordingStore";
+    private static final String PENDING="pending_uri";
+    private final Context context;
+    private final Uri uri;
+    private final String name;
+    private ParcelFileDescriptor descriptor;
+    private boolean published;
+
+    private static SharedPreferences state(Context context) {
+        return context.getSharedPreferences("fm-recording-store",Context.MODE_PRIVATE);
+    }
+
+    static void recover(Context context) {
+        String saved=state(context).getString(PENDING,null);
+        if(saved==null)return;
+        Uri uri=Uri.parse(saved);
+        // Only a row persisted by this app can be recovered. Never delete a
+        // published recording after a crash between publication and commit.
+        if(!saved.matches("content://media/external/audio/media/[0-9]+")) {
+            Log.e(TAG,"Unexpected pending recording URI; leaving it untouched");return;
+        }
+        try(Cursor row=context.getContentResolver().query(uri,
+                new String[]{MediaStore.Audio.Media.IS_PENDING,MediaStore.MediaColumns.OWNER_PACKAGE_NAME},null,null,null)) {
+            if(row!=null && row.moveToFirst() && row.getInt(0)==1 && context.getPackageName().equals(row.getString(1)))
+                context.getContentResolver().delete(uri,null,null);
+            state(context).edit().remove(PENDING).commit();
+        }catch(RuntimeException error){Log.w(TAG,"Could not recover own pending recording",error);}
+    }
+
+    FmRecordingStore(Context context) throws IOException {
+        this.context=context;
+        if(state(context).contains(PENDING))throw new IOException("An earlier own recording still needs recovery");
+        name="FM-"+new SimpleDateFormat("yyyy-MM-dd-HH-mm-ss",Locale.ROOT).format(new Date())+"-"+UUID.randomUUID()+".m4a";
+        ContentValues values=new ContentValues();
+        values.put(MediaStore.Audio.Media.DISPLAY_NAME,name);
+        values.put(MediaStore.Audio.Media.MIME_TYPE,"audio/mp4");
+        values.put(MediaStore.Audio.Media.RELATIVE_PATH,Environment.DIRECTORY_MUSIC+"/FMRecording/");
+        values.put(MediaStore.Audio.Media.IS_PENDING,1);
+        uri=context.getContentResolver().insert(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI,values);
+        if(uri==null)throw new IOException("Cannot create a pending FM recording");
+        boolean ready=false;
+        try {
+            if(!state(context).edit().putString(PENDING,uri.toString()).commit())throw new IOException("Cannot save pending recording state");
+            descriptor=context.getContentResolver().openFileDescriptor(uri,"rw");
+            if(descriptor==null)throw new IOException("Cannot open the pending FM recording");
+            ready=true;
+        }finally{if(!ready)close();}
+    }
+
+    FileDescriptor descriptor(){return descriptor.getFileDescriptor();}
+    String displayPath(){return Environment.DIRECTORY_MUSIC+"/FMRecording/"+name;}
+
+    void publish(long durationMillis) throws IOException {
+        if(descriptor!=null){descriptor.close();descriptor=null;}
+        ContentValues values=new ContentValues();
+        values.put(MediaStore.Audio.Media.IS_PENDING,0);
+        values.put(MediaStore.Audio.Media.DURATION,durationMillis);
+        values.put(MediaStore.Audio.Media.TITLE,name.substring(0,name.length()-4));
+        values.put(MediaStore.Audio.Media.ARTIST,context.getString(R.string.audio_db_artist_name));
+        values.put(MediaStore.Audio.Media.ALBUM,context.getString(R.string.audio_db_album_name));
+        values.put(MediaStore.Audio.Media.IS_MUSIC,1);
+        if(context.getContentResolver().update(uri,values,null,null)!=1)throw new IOException("Cannot publish the FM recording");
+        published=true;
+        if(!state(context).edit().remove(PENDING).commit())Log.w(TAG,"Published recording state will be recovered on next start");
+        Log.i(TAG,"Published FM recording "+uri+" duration_ms="+durationMillis);
+    }
+
+    @Override public void close() throws IOException {
+        try {if(descriptor!=null)descriptor.close();}
+        finally {
+            descriptor=null;
+            if(!published)context.getContentResolver().delete(uri,null,null);
+            state(context).edit().remove(PENDING).commit();
+        }
+    }
+}
