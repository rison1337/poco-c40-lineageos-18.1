diff --git a/Xiaomi/PocoC40/res/values/config.xml b/Xiaomi/PocoC40/res/values/config.xml
new file mode 100644
index 0000000..0a28f65
--- /dev/null
+++ b/Xiaomi/PocoC40/res/values/config.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Read on the actual frost RU V13.0.17.0, 720x1650 / density 320.
+         Values and query results: stock-framework-resource-values.json. -->
+    <string name="config_mainBuiltInDisplayCutout" translatable="false">M 0,0 H -40 V 49 H 40 V 0 H 0 Z</string>
+    <dimen name="status_bar_height_portrait">49px</dimen>
+    <bool name="config_showNavigationBar">true</bool>
+    <bool name="config_powerDecoupleInteractiveModeFromDisplay">false</bool>
+    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
+    <bool name="config_enableAutoPowerModes">true</bool>
+    <!-- IMS capabilities measured on stock; carrier provisioning remains required. -->
+    <bool name="config_device_volte_available">true</bool>
+    <bool name="config_device_vt_available">true</bool>
+    <bool name="config_device_wfc_ims_available">true</bool>
+</resources>
