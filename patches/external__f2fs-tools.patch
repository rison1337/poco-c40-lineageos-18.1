diff --git a/fsck/c40_f2fs_relocation.c b/fsck/c40_f2fs_relocation.c
new file mode 100644
index 0000000..d26c134
--- /dev/null
+++ b/fsck/c40_f2fs_relocation.c
@@ -0,0 +1,109 @@
+/* Host-only analysis of a regular-file clone; never installed into Android. */
+#include "fsck.h"
+#include "c40_f2fs_relocation.h"
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static FILE *journal;
+static u64 expected,records,fbe_count,data_count,node_count;
+static block_t old_main,new_main;
+static int inventory_mode;
+
+int c40_relocation_preflight(void)
+{
+    const char *source=getenv("C40_FBE_SOURCE_VIEW"),*log=getenv("C40_FBE_RELOCATION_LOG");
+    struct stat original,clone;
+    unsigned char before[8192],after[8192];
+    int src=-1,dst=-1,fd=-1,ok=0;
+    umask(0077);
+    inventory_mode=c.func==DUMP;
+    if((c.func!=RESIZE && !inventory_mode) || c.safe_resize || c.sparse_mode || !source || !log || !c.devices[0].path)goto out;
+    if(inventory_mode){c.ro=1;c.dry_run=1;c.no_kernel_check=1;c.quota_fix=0;}
+    src=open(source,O_RDONLY|O_CLOEXEC|O_NOFOLLOW);
+    dst=open(c.devices[0].path,O_RDONLY|O_CLOEXEC|O_NOFOLLOW);
+    if(src<0 || dst<0 || fstat(src,&original) || fstat(dst,&clone) ||
+       !S_ISREG(original.st_mode) || !S_ISREG(clone.st_mode) ||
+       (!inventory_mode && ((original.st_dev==clone.st_dev && original.st_ino==clone.st_ino) || clone.st_size<=original.st_size)))goto out;
+    if(pread(src,before,sizeof(before),0)!=sizeof(before) || pread(dst,after,sizeof(after),0)!=sizeof(after) ||
+       memcmp(before,after,sizeof(before)))goto out;
+    fd=open(log,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);
+    if(fd<0)goto out;
+    journal=fdopen(fd,"w");
+    if(!journal){close(fd);goto out;}
+    ok=1;
+out:
+    if(src>=0)close(src);
+    if(dst>=0)close(dst);
+    if(!ok)fprintf(stderr,"C40: require distinct regular-file clone/source, matching superblocks and new private log; full grow only\n");
+    return ok?0:-1;
+}
+
+void c40_relocation_begin(struct f2fs_sb_info *sbi,unsigned int from,unsigned int to)
+{
+    struct f2fs_super_block *sb=F2FS_RAW_SUPER(sbi);
+    unsigned int i,j;
+    ASSERT(journal!=NULL && c.ndevs==1 && to>=from);
+    /* Compression is unsupported by the actual C40 kernel and this tools generation. */
+    ASSERT(!(le32_to_cpu(sb->feature)&0x2000));
+    old_main=from;new_main=to;
+    expected=records=fbe_count=data_count=node_count=0;
+    for(i=0;i<TOTAL_SEGS(sbi);i++){
+        struct seg_entry *se=get_seg_entry(sbi,i);
+        unsigned int bits=0;
+        for(j=0;j<sbi->blocks_per_seg;j++)bits+=!!f2fs_test_bit(j,(const char *)se->cur_valid_map);
+        ASSERT(bits==se->valid_blocks);
+        expected+=bits;
+    }
+    ASSERT(fprintf(journal,"{\"type\":\"header\",\"version\":1,\"operation\":\"%s\",\"block_bytes\":4096,\"source_main\":%u,\"target_main\":%u,\"expected_records\":%"PRIu64",\"checkpoint_clean\":%s,\"forced_full_main_migration\":%s}\n",
+        inventory_mode?"inventory":"grow",from,to,expected,is_set_ckpt_flags(F2FS_CKPT(sbi),CP_UMOUNT_FLAG)?"true":"false",inventory_mode?"false":"true")>0);
+}
+
+void c40_relocation_record(struct f2fs_sb_info *sbi,block_t from,block_t to,int data,const struct f2fs_summary *sum)
+{
+    char kind='N';nid_t ino=0;
+    ASSERT(journal!=NULL && to-from==new_main-old_main);
+    if(data){
+        struct node_info owner,inode;
+        struct f2fs_node raw;
+        get_node_info(sbi,le32_to_cpu(sum->nid),&owner);
+        ASSERT(owner.ino>0 && owner.ino<NM_I(sbi)->max_nid);
+        get_node_info(sbi,owner.ino,&inode);
+        ASSERT(inode.blk_addr!=NULL_ADDR && inode.blk_addr!=NEW_ADDR);
+        ASSERT(dev_read_block(&raw,inode.blk_addr)>=0);
+        ASSERT(le32_to_cpu(raw.footer.nid)==owner.ino && le32_to_cpu(raw.footer.ino)==owner.ino);
+        ino=owner.ino;
+        /* Exactly the kernel's IS_ENCRYPTED(inode) && S_ISREG(inode->i_mode). */
+        kind=(LINUX_S_ISREG(le16_to_cpu(raw.i.i_mode)) && file_is_encrypt(&raw.i))?'F':'D';
+    }
+    ASSERT(fprintf(journal,"{\"type\":\"block\",\"kind\":\"%c\",\"from\":%u,\"to\":%u,\"ino\":%u,\"nid\":%u}\n",kind,from,to,ino,le32_to_cpu(sum->nid))>0);
+    records++;
+    if(kind=='F')fbe_count++;
+    else if(kind=='D')data_count++;
+    else node_count++;
+}
+
+void c40_relocation_finish(void)
+{
+    ASSERT(records==expected);
+    ASSERT(fprintf(journal,"{\"type\":\"complete\",\"records\":%"PRIu64",\"fbe_blocks\":%"PRIu64",\"other_data_blocks\":%"PRIu64",\"node_blocks\":%"PRIu64"}\n",records,fbe_count,data_count,node_count)>0);
+    ASSERT(fflush(journal)==0 && fsync(fileno(journal))==0);
+    ASSERT(fclose(journal)==0);journal=NULL;
+}
+
+void c40_relocation_inventory(struct f2fs_sb_info *sbi)
+{
+    struct f2fs_super_block *sb=F2FS_RAW_SUPER(sbi);
+    unsigned int i,j;
+    c40_relocation_begin(sbi,le32_to_cpu(sb->main_blkaddr),le32_to_cpu(sb->main_blkaddr));
+    for(i=0;i<TOTAL_SEGS(sbi);i++){
+        struct seg_entry *se=get_seg_entry(sbi,i);
+        for(j=0;j<sbi->blocks_per_seg;j++){
+            struct f2fs_summary sum;block_t block;
+            if(!f2fs_test_bit(j,(const char *)se->cur_valid_map))continue;
+            block=START_BLOCK(sbi,i)+j;get_sum_entry(sbi,block,&sum);
+            c40_relocation_record(sbi,block,block,IS_DATASEG(se->type),&sum);
+        }
+    }
+    c40_relocation_finish();
+}
