 						new_main_blkaddr, 0);
@@ -625,6 +637,9 @@ static int f2fs_resize_grow(struct f2fs_sb_info *sbi)
 			offset_seg = offset >> get_sb(log_blocks_per_seg);
 		MSG(0, "Try to do defragement: %s\n", err ? "Skip": "Done");
