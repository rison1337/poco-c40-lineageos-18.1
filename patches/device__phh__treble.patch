-setprop sys.usb.ffs.aio_compat true
-setprop persist.adb.nonblocking_ffs false
+# frost's stock DWC2 kernel panics on some short synchronous FFS reads.
+# Keep the normal Android 11 aligned asynchronous transport on this device.
+if [ "$(getprop ro.product.vendor.device)" = frost ]; then
+    setprop sys.usb.ffs.aio_compat false
+    setprop persist.adb.nonblocking_ffs true
+else
+    setprop sys.usb.ffs.aio_compat true
+    setprop persist.adb.nonblocking_ffs false
+fi
 
 fixSPL() {
     if [ "$(getprop ro.product.cpu.abi)" = "armeabi-v7a" ]; then
@@ -301,6 +308,38 @@ done
 mkdir -p /mnt/phh/
 mount -t tmpfs -o rw,nodev,relatime,mode=755,gid=0 none /mnt/phh || true
 mkdir /mnt/phh/empty_dir
+
+# BEGIN C40 sensor flush accounting
+# Wake-up flush metadata has header.sensor=0. Classify its drain by per-sensor
+# ring handle, as the stock writer already does. Apply only to the exact blob.
+if [ "$(getprop ro.product.vendor.device)" = frost ] &&
+   [ "$(sha256sum /vendor/lib64/libhubconnection.so | cut -d ' ' -f 1)" = a18bb56643d952a8f61460c27158a6ffd1db9baa8be8a73820bc1856b50cd601 ] &&
+   [ "$(sha256sum /system/etc/c40-sensors/libhubconnection-flush-fixed.so | cut -d ' ' -f 1)" = 63713863dbbf290fc7f39582617adea5bebb75bd63fe6392867c2581e62aad9d ]; then
+    if cp /system/etc/c40-sensors/libhubconnection-flush-fixed.so /mnt/phh/c40-sensors-hub.so &&
+       chmod 0644 /mnt/phh/c40-sensors-hub.so &&
+       chcon u:object_r:vendor_file:s0 /mnt/phh/c40-sensors-hub.so &&
+       [ "$(sha256sum /mnt/phh/c40-sensors-hub.so | cut -d ' ' -f 1)" = 63713863dbbf290fc7f39582617adea5bebb75bd63fe6392867c2581e62aad9d ] &&
+       mount -o bind /mnt/phh/c40-sensors-hub.so /vendor/lib64/libhubconnection.so; then
+        log -t c40-sensors 'Wake-up flush accounting correction mounted'
+        if [ "$(getprop init.svc.vendor.sensors-hal-2-1)" = running ]; then
+            setprop ctl.restart vendor.sensors-hal-2-1
+        fi
+    fi
+fi
+# END C40 sensor flush accounting
+
+# Stock frost's policy selects the QTI-private session API, while Lineage's
+# Bluetooth stack starts android.hardware.bluetooth.audio@2.0 sessions.
+# The vendor already supplies audio.bluetooth.default with that standard API.
+if [ "$(getprop ro.product.vendor.device)" = frost ] &&
+   [ -f /vendor/etc/bluetooth_qti_audio_policy_configuration.xml ] &&
+   [ -f /vendor/lib/hw/audio.bluetooth.default.so ]; then
+    cp /vendor/etc/bluetooth_qti_audio_policy_configuration.xml /mnt/phh/c40-bluetooth-policy.xml
+    sed -i 's/name="bluetooth_qti"/name="bluetooth"/' /mnt/phh/c40-bluetooth-policy.xml
+    chmod 0644 /mnt/phh/c40-bluetooth-policy.xml
+    chcon u:object_r:vendor_configs_file:s0 /mnt/phh/c40-bluetooth-policy.xml
+    mount -o bind /mnt/phh/c40-bluetooth-policy.xml /vendor/etc/bluetooth_qti_audio_policy_configuration.xml
+fi
