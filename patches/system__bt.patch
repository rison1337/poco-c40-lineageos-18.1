+    LOG_DEBUG(LOG_TAG, "post-filtering supported feature 0x%x is 0x%x", i, feature_pages[*page_number_ptr].as_array[i]);
+
+  LOG_DEBUG(LOG_TAG, "supported_features array done");
+
   buffer_allocator->free(response);
 }
 
