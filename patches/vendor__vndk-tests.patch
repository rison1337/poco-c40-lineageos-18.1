 if [ "$HOST_OS" == "Darwin" ]; then
   TARGET_INCLUDE=darwin
 fi
+HOST_BIN="${OUT_DIR:-out}/host/${TARGET_INCLUDE}-x86/bin"
 
 t="$(mktemp)"
 [ -f "$2"/system/etc/selinux/mapping/26.0.cil ] && for vndk in 26 27;do
