// Personal frost build: blobs extracted from RU V13.0.17.0.RGFRUXM.
cc_prebuilt_library_shared {
    name: "c40_ims_lib-imsvideocodec",
    stem: "lib-imsvideocodec",
    system_ext_specific: true,
    compile_multilib: "both",
    arch: {
        arm: { srcs: ["proprietary/system_ext/lib/lib-imsvideocodec.so"] },
        arm64: { srcs: ["proprietary/system_ext/lib64/lib-imsvideocodec.so"] },
    },
    shared_libs: ["c40_ims_lib-imsvtutils", "c40_ims_lib-imsvtextutils", "libcutils", "libutils", "liblog", "c40_ims_libdiag_system", "libgui", "libandroid", "libnativewindow", "libmediandk", "libc++", "libc", "libm", "libdl"],
    stl: "none",
    strip: { none: true },
    check_elf_files: true,
    allow_undefined_symbols: false,
}

