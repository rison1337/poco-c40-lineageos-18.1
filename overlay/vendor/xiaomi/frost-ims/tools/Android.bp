// Diagnostic helper only. It is not installed into the ROM.
cc_binary {
    name: "c40_dsu_verify",
    installable: false,
    srcs: ["c40_dsu_verify.cpp"],
    shared_libs: [
        "gsi_aidl_interface-cpp", "libbase", "libbinder", "libcutils",
        "libgsi", "liblog", "libutils", "libcrypto",
    ],
    static_libs: ["libgsid"],
}

// Host-controlled updater; never shipped in the Android image.
cc_binary {
    name: "c40_dsu_maintain",
    installable: false,
    srcs: ["c40_dsu_maintain.cpp"],
    shared_libs: [
        "gsi_aidl_interface-cpp", "libbase", "libbinder", "libcutils",
        "libgsi", "liblog", "libutils", "libcrypto",
    ],
    static_libs: ["libgsid"],
}

// Read-only probe, not included in any Android product.
cc_binary {
    name: "c40_dsu_storage_probe",
    installable: false,
    srcs: ["c40_dsu_storage_probe.cpp", ":c40_readonly_keymaster_sources"],
    header_libs: ["libvold_headers"],
    shared_libs: [
        "android.hardware.keymaster@3.0", "android.hardware.keymaster@4.0",
        "android.hardware.keymaster@4.1", "libkeymaster4support", "libkeymaster4_1support",
        "libhidlbase", "libbase", "libbinder", "libutils", "libcrypto", "liblog",
        "libcutils", "gsi_aidl_interface-cpp", "libgsi",
    ],
    static_libs: ["libdm", "libgsid", "libext2_uuid"],
}

// Separate DSU slot migration helper, not installed into the ROM.
cc_binary {
    name: "c40_dsu_slot",
    installable: false,
    srcs: ["c40_dsu_slot.cpp"],
    shared_libs: [
        "gsi_aidl_interface-cpp", "libbase", "libbinder", "libcutils",
        "libgsi", "liblog", "libutils", "libcrypto", "libcrypto_utils",
    ],
    static_libs: ["libgsid", "libfs_mgr", "libdm", "liblp", "libext4_utils"],
}
